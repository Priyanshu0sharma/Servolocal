# ╔══════════════════════════════════════════════════════════════════╗
# ║       ServoLocal Backend — Environment Configuration Template    ║
# ║       Copy this file to .env and replace placeholder values      ║
# ╚══════════════════════════════════════════════════════════════════╝

# Service Info
SERVICE_NAME="servolocal-api"
APP_ENV="development"
VERSION="1.0.0"
DEBUG=False

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,https://servolocal.vercel.app,https://servopartner.vercel.app,https://admin-web-one-jet.vercel.app,https://servolocal.in"

# ─── Neon Serverless PostgreSQL (Connection Pooler) ────────────────
# Get from: Neon Console -> Connection details (Pooled connection string)
DATABASE_URL="postgresql://user:password@ep-ancient-cloud-xxxx-pooler.region.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Upstash Redis Cache Layer ─────────────────────────────────────
# Get from: Upstash Console -> Redis Database -> REST API
REDIS_URL="rediss://default:token@measured-puma-xxxx.upstash.io:6379"
UPSTASH_REDIS_REST_URL="https://measured-puma-xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# ─── Cloudflare R2 Object Storage ──────────────────────────────────
# Get from: Cloudflare Dashboard -> R2 -> Manage API Tokens
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="servolocal"
R2_PUBLIC_URL="https://pub-your_bucket_id.r2.dev"
R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"
R2_TOKEN="your_r2_api_token"

# ─── Razorpay Payment Gateway ──────────────────────────────────────
# Get from: Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# ─── Google OAuth 2.0 ──────────────────────────────────────────────
# Get from: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ─── Resend / Brevo Transactional Email ────────────────────────────
# Get from: Resend Dashboard -> API Keys
RESEND_API_KEY="re_your_resend_api_key"
BREVO_API_KEY="xkeysib-your_brevo_api_key"
EMAIL_FROM="ServoLocal <Servolocal@resend.dev>"

# ─── Gmail SMTP Fallback ───────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_google_app_password"

# ─── JWT Authentication Security ───────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="generate_a_cryptographically_secure_random_64_character_hex_string"
JWT_ALGORITHM="HS256"
JWT_EXPIRY_DAYS=30

# ─── Firebase Admin SDK (Server Push Notifications) ────────────────
FIREBASE_ADMIN_TYPE="service_account"
FIREBASE_ADMIN_PROJECT_ID="servolocal-xxxx"
FIREBASE_ADMIN_PRIVATE_KEY_ID="your_firebase_private_key_id"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@servolocal-xxxx.iam.gserviceaccount.com"
FIREBASE_ADMIN_CLIENT_ID="your_firebase_admin_client_id"
FIREBASE_ADMIN_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
FIREBASE_ADMIN_TOKEN_URI="https://oauth2.googleapis.com/token"
FIREBASE_ADMIN_AUTH_PROVIDER_CERT_URL="https://www.googleapis.com/oauth2/v1/certs"
FIREBASE_ADMIN_CLIENT_CERT_URL="https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40servolocal-xxxx.iam.gserviceaccount.com"

# ─── Business Platform Constants ───────────────────────────────────
PLATFORM_FEE=5.0
MIN_WALLET_DUE_LOCK=-200.0
DEFAULT_DELIVERY_RADIUS_KM=5.0
DEFAULT_FREE_DELIVERY_ABOVE=150.0
