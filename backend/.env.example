# ╔══════════════════════════════════════════════════════════════════╗
# ║       ServoLocal Backend — Environment Configuration Template    ║
# ╚══════════════════════════════════════════════════════════════════╝

# Service Info
SERVICE_NAME="servolocal-api"
APP_ENV="development"
VERSION="1.0.0"

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://servolocal.in"

# Database Configuration (PostgreSQL - To be connected in next step)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Redis Configuration (To be connected in next step)
REDIS_URL="rediss://default:token@host:6379"

# Security Settings - REQUIRED: Set a cryptographically secure key (No fallback allowed)
JWT_SECRET=""
JWT_ALGORITHM="HS256"
